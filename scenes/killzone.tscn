[gd_scene format=3 uid="uid://c8mddhecy1pvk"]

[sub_resource type="GDScript" id="GDScript_csqde"]
script/source = "extends Area3D

func _on_area_entered(area: Area3D) -> void:
	var note_node: Node = area
	if not area.is_in_group(\"notes\") and area.get_parent() and area.get_parent().is_in_group(\"notes\"):
		note_node = area.get_parent()

	if note_node.is_in_group(\"notes\"):
		Globals.combo = 0
		
		if \"current_life\" in Globals:
			Globals.current_life -= 5.0
			
		
		note_node.queue_free()
	else:
		area.queue_free()
"

